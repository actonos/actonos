{
  "name": "actonos-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:emoji": "node scripts/check-no-emoji.mjs",
    "audit:i18n": "node scripts/audit-hardcoded-text.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "quality": "npm run lint && npm run check:i18n && npm run check:emoji && npm run audit:i18n -- --fail && npm run test && npm run build && npm run check:bundle && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/noto-sans": "^5.2.8",
    "@tiptap/extension-code-block": "^3.30.1",
    "@tiptap/extension-highlight": "^3.30.1",
    "@tiptap/extension-horizontal-rule": "^3.30.1",
    "@tiptap/extension-link": "^3.30.1",
    "@tiptap/extension-table": "^3.30.1",
    "@tiptap/extension-table-cell": "^3.30.1",
    "@tiptap/extension-table-header": "^3.30.1",
    "@tiptap/extension-table-row": "^3.30.1",
    "@tiptap/extension-typography": "^3.30.1",
    "@tiptap/react": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "i18next": "^24.2.2",
    "i18next-browser-languagedetector": "^8.0.2",
    "lucide-react": "^0.475.0",
    "marked": "^18.0.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.0.7",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.0.7",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  }
}
