[Unit]
Description=ActonOS AI Agent Operating System Daemon
Documentation=https://actonos.org/docs
After=network.target network-online.target dbus.service embeddingd.service
Wants=network-online.target embeddingd.service

[Service]
Type=simple
User=acton
Group=acton
WorkingDirectory=/data

# Ensure /data hierarchy and permissions exist before starting (runs with root privileges via '+' prefix)
ExecStartPre=+/bin/mkdir -p /data
ExecStartPre=+/bin/chown -R acton:acton /data
ExecStartPre=+/bin/chmod 755 /data

ExecStart=/usr/local/bin/actond --data-dir=/data --listen-addr=:8080 --embedding-url=http://127.0.0.1:8091
Restart=always
RestartSec=3s
LimitNOFILE=65536
LimitNPROC=4096
StandardOutput=journal
StandardError=journal
Environment=DATA_DIR=/data
Environment=PORT=8080
Environment=RUNTIME_MODE=baremetal
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/data/bin

[Install]
WantedBy=multi-user.target
