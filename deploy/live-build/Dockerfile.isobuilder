# ==============================================================================
# ActonOS Universal Dockerized ISO Builder
# Builds Debian Live Hybrid ISO with custom branding, GRUB, and preseed
# ==============================================================================
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    live-build \
    debootstrap \
    xorriso \
    isolinux \
    syslinux-common \
    syslinux-efi \
    grub-pc-bin \
    grub-efi-amd64-bin \
    qemu-user-static \
    binfmt-support \
    mtools \
    dosfstools \
    squashfs-tools \
    cpio \
    fakeroot \
    ca-certificates \
    git \
    curl \
    wget \
    rsync \
    python3 \
    build-essential \
    gcc-aarch64-linux-gnu \
    && rm -rf /var/lib/apt/lists/*

# Embed official static Go 1.26 toolchain
COPY --from=golang:1.26-alpine /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}"

# Embed official Node.js 22 LTS toolchain
COPY --from=node:22-bookworm-slim /usr/local/bin /usr/local/bin
COPY --from=node:22-bookworm-slim /usr/local/lib/node_modules /usr/local/lib/node_modules

# Copy the entire workspace into container (respecting .dockerignore to skip host node_modules, git, etc.)
COPY . /workspace/

WORKDIR /workspace

CMD ["/bin/bash", "scripts/build-iso.sh"]
