# ==============================================================================
# ActonOS Docker Deployment Environment Configuration
# Copy this file to .env before running docker compose:
#   cp .env.example .env
# ==============================================================================

# Server Port exposed on Host
PORT=8080

# Logging Level: debug, info, warn, error
LOG_LEVEL=info

# Version / Tag to build or deploy
VERSION=latest

# Resource Limits for Agent Container
CPU_LIMIT=2.0
MEM_LIMIT=2048M

# Security / Session Encryption Secret Key (Optional, auto-generated if empty)
# ACTONOS_SECRET_KEY=your-random-32-character-secret-key-here

# Optional: Default LLM API Keys (Can also be set in Web UI Settings)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIzaSy...
# GROQ_API_KEY=gsk_...
# OLLAMA_BASE_URL=http://host.docker.internal:11434
